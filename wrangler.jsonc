{
  "name": "seekr-paper-tracker",
  "main": "worker.js",
  "compatibility_date": "2026-09-20",
  "triggers": {
    "crons": [
      "*/3 * * * *",
      "49,59 18 1 10 *",
      "9,19,29,39 19 1 10 *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STATE",
        "class_name": "State"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "State"
      ]
    }
  ]
}
