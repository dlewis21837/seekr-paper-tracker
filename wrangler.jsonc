{
  "name": "seekr-paper-tracker",
  "main": "Seeker.js",
  "compatibility_date": "2026-09-20",
  "triggers": {
    "crons": ["*/3 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STATE",
        "class_name": "State"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["State"]
    }
  ]
}
